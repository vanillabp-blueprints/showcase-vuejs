<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.acme</groupId>
    <artifactId>business-cockpit-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>business-cockpit-ui-types</artifactId>
  <name>Types of the user interface for workflow modules</name>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <properties>
    <ui-uri-types.package>com.acme.cockpit.ui</ui-uri-types.package>
    <ui-uri-types.sources>${project.build.directory}/generated-sources/ui-uri-types</ui-uri-types.sources>
    <!-- Where the npm package of the types library is unpacked, see README.md -->
    <ui-uri-types.json>${project.build.directory}/bc-types/package/ui-uri-types.json</ui-uri-types.json>
  </properties>

  <profiles>
    <!-- A release takes the registry. -Dbc-types.local=<folder with ui-uri-types.json> skips the download. -->
    <profile>
      <id>bc-types-from-the-registry</id>
      <activation>
        <property>
          <name>!bc-types.local</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>io.github.download-maven-plugin</groupId>
            <artifactId>download-maven-plugin</artifactId>
            <version>2.2.0</version>
            <executions>
              <execution>
                <id>download-bc-types</id>
                <phase>generate-sources</phase>
                <goals>
                  <goal>wget</goal>
                </goals>
                <configuration>
                  <url>https://registry.npmjs.org/@acme/bc-types/-/bc-types-${ui.version}.tgz</url>
                  <unpack>true</unpack>
                  <outputDirectory>${project.build.directory}/bc-types</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>bc-types-local</id>
      <activation>
        <property>
          <name>bc-types.local</name>
        </property>
      </activation>
      <properties>
        <ui-uri-types.json>${bc-types.local}/ui-uri-types.json</ui-uri-types.json>
      </properties>
    </profile>
  </profiles>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>write-ui-uri-types</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${java.home}/bin/java</executable>
              <arguments>
                <argument>${project.basedir}/src/build/GenerateUiUriTypes.java</argument>
                <argument>${ui-uri-types.json}</argument>
                <argument>${ui-uri-types.sources}</argument>
                <argument>${ui-uri-types.package}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>add-ui-uri-types</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${ui-uri-types.sources}</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <ui-uri-types.json>${ui-uri-types.json}</ui-uri-types.json>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
